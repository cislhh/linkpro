# ============================================
# LinkPro Environment Variables
# ============================================
# Copy this file to .env and update the values
# NEVER commit .env to version control
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 
# Local development example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkpro"
#
# Vercel Postgres example:
# DATABASE_URL="postgres://user:password@host.postgres.vercel-storage.com:5432/database?sslmode=require"
#
# Neon example:
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/database?sslmode=require"
#
# Supabase example:
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkpro"

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# Secret key for encrypting JWT tokens and session cookies
# Generate a secure secret using: openssl rand -base64 32
# IMPORTANT: Use a strong, unique secret in production!
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# The canonical URL of your site
# In development: http://localhost:3000
# In production: https://your-domain.com (or your Vercel URL)
# Note: Vercel automatically sets this in production deployments
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================
# Uncomment and configure if using analytics services

# Vercel Analytics (automatically enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ============================================
# OPTIONAL: IMAGE STORAGE
# ============================================
# If using external image storage for user avatars

# Cloudinary (example)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# AWS S3 (example)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""

# ============================================
# NODE ENVIRONMENT
# ============================================
# Set to "production" in production deployments
# Vercel automatically sets this
NODE_ENV="development"
